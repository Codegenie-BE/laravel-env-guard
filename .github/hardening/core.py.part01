    '''    private function isLikelyTextFile(string $path): bool
    {
        $handle = @fopen($path, 'rb');

        if ($handle === false) {
            return false;
        }

        $sample = fread($handle, 4096);
        fclose($handle);

        return $sample !== false && ! str_contains($sample, "\\0");
    }

    /** @return list<string> */
    private function environmentPaths(): array
''',
