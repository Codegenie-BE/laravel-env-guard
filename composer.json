{
    "name": "codegenie-be/laravel-env-guard",
    "description": "Automatically audit Laravel environment variables for missing, unused, duplicate, inconsistent and unsafe usage during development.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "environment",
        "dotenv",
        "env",
        "configuration",
        "guard",
        "static-analysis",
        "developer-tools",
        "codegenie"
    ],
    "authors": [
        {
            "name": "Codegenie",
            "homepage": "https://www.codegenie.be"
        }
    ],
    "support": {
        "issues": "https://github.com/Codegenie-BE/laravel-env-guard/issues",
        "forum": "https://github.com/Codegenie-BE/laravel-env-guard/discussions",
        "source": "https://github.com/Codegenie-BE/laravel-env-guard"
    },
    "require": {
        "php": "^8.2",
        "ext-tokenizer": "*",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codegenie\\EnvGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codegenie\\EnvGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codegenie\\EnvGuard\\EnvGuardServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@check:composer",
            "@check:security",
            "@check:autoload",
            "@format:test",
            "@analyse"
        ],
        "check:all": [
            "@check",
            "@test"
        ],
        "check:autoload": "@composer dump-autoload --optimize --strict-psr --no-interaction",
        "check:composer": "@composer validate --strict",
        "check:security": "@composer audit --no-interaction",
        "format": "pint",
        "format:test": "pint --test",
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "test:e2e": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/E2E/runner.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts-descriptions": {
        "analyse": "Run Larastan static analysis.",
        "check": "Run the fast Composer, security, autoload, formatting and static-analysis quality gate.",
        "check:all": "Run the fast quality gate and the complete Pest suite.",
        "check:autoload": "Build an optimized autoloader and reject invalid PSR mappings.",
        "check:composer": "Validate composer.json strictly.",
        "check:security": "Audit installed dependencies for known security advisories.",
        "format": "Apply Laravel Pint formatting.",
        "format:test": "Check Laravel Pint formatting without changing files.",
        "test": "Run the Pest suite.",
        "test:coverage": "Run Pest with the enforced 80% coverage baseline.",
        "test:e2e": "Install the package into a fresh Laravel application and exercise boot-time guard scenarios."
    }
}
